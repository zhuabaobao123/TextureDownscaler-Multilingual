<?xml version="1.0" encoding="utf-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
	<moduleName>TextureDownscaler - Multilingual</moduleName>

	<requiredInstallFiles>
		<file source="DLL\TextureDownscaler.dll" destination="SKSE\Plugins\TextureDownscaler.dll" priority="0" />
		<file source="DLL\TextureDownscaler.pdb" destination="SKSE\Plugins\TextureDownscaler.pdb" priority="1" />
	</requiredInstallFiles>

	<installSteps order="Explicit">
		<installStep name="Interface language">
			<optionalFileGroups>
				<group type="SelectExactlyOne" name="Choose the interface language">
					<plugins order="Explicit">
						<plugin name="English">
							<description>English interface. The menu stays in English.</description>
							<files><file source="lang\en\SKSE\Plugins\TextureDownscaler.json" destination="SKSE\Plugins\TextureDownscaler.json" priority="0" /></files>
							<typeDescriptor><type name="Optional" /></typeDescriptor>
						</plugin>
						<plugin name="简体中文">
							<description>游戏内菜单显示为简体中文。字形由 SKSE Menu Framework 的字体设置决定。</description>
							<files><file source="lang\zh-CN\SKSE\Plugins\TextureDownscaler.json" destination="SKSE\Plugins\TextureDownscaler.json" priority="0" /></files>
							<typeDescriptor><type name="Optional" /></typeDescriptor>
						</plugin>
						<plugin name="日本語">
							<description>ゲーム内メニューが日本語になります。フォントは SKSE Menu Framework の設定で決まります。</description>
							<files><file source="lang\ja\SKSE\Plugins\TextureDownscaler.json" destination="SKSE\Plugins\TextureDownscaler.json" priority="0" /></files>
							<typeDescriptor><type name="Optional" /></typeDescriptor>
						</plugin>
						<plugin name="한국어">
							<description>게임 내 메뉴가 한국어로 표시됩니다. 글꼴은 SKSE Menu Framework 설정을 따릅니다.</description>
							<files><file source="lang\ko\SKSE\Plugins\TextureDownscaler.json" destination="SKSE\Plugins\TextureDownscaler.json" priority="0" /></files>
							<typeDescriptor><type name="Optional" /></typeDescriptor>
						</plugin>
						<plugin name="Русский">
							<description>Интерфейс в игре станет русскоязычным. Шрифт задаётся настройками SKSE Menu Framework.</description>
							<files><file source="lang\ru\SKSE\Plugins\TextureDownscaler.json" destination="SKSE\Plugins\TextureDownscaler.json" priority="0" /></files>
							<typeDescriptor><type name="Optional" /></typeDescriptor>
						</plugin>
						<plugin name="Français">
							<description>L'interface en jeu passe en français. La police dépend des réglages de SKSE Menu Framework.</description>
							<files><file source="lang\fr\SKSE\Plugins\TextureDownscaler.json" destination="SKSE\Plugins\TextureDownscaler.json" priority="0" /></files>
							<typeDescriptor><type name="Optional" /></typeDescriptor>
						</plugin>
						<plugin name="Deutsch">
							<description>Das In-Game-Menü wird auf Deutsch angezeigt. Die Schrift folgt den Einstellungen des SKSE Menu Framework.</description>
							<files><file source="lang\de\SKSE\Plugins\TextureDownscaler.json" destination="SKSE\Plugins\TextureDownscaler.json" priority="0" /></files>
							<typeDescriptor><type name="Optional" /></typeDescriptor>
						</plugin>
						<plugin name="Español">
							<description>El menú del juego pasará a mostrarse en español. La fuente depende de SKSE Menu Framework.</description>
							<files><file source="lang\es\SKSE\Plugins\TextureDownscaler.json" destination="SKSE\Plugins\TextureDownscaler.json" priority="0" /></files>
							<typeDescriptor><type name="Optional" /></typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
	</installSteps>
</config>
